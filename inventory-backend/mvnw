PRG="$0"
while [ -h "$PRG" ]; do
  ls=$(ls -ld "$PRG")
  link=$(expr "$ls" : '.*-> \(.*\)$')
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG="$(dirname "$PRG")/$link"
  fi
done

SCRIPT_DIR=$(cd "$(dirname "$PRG")" >/dev/null 2>&1 && pwd)

if [ -z "$JAVA_HOME" ]; then
  JAVA_CMD=java
else
  JAVA_CMD="$JAVA_HOME/bin/java"
fi

if [ ! -x "$JAVA_CMD" ]; then
  JAVA_CMD=java
fi

if [ ! -f "$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar" ]; then
  echo "ERROR: Maven wrapper jar not found. Expected $SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"
  exit 1
fi

exec "$JAVA_CMD" -Dmaven.multiModuleProjectDirectory="$SCRIPT_DIR" -cp "$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar" org.apache.maven.wrapper.MavenWrapperMain "$@"
